# ==============================================================================
# AcxiomCRM Environment Configuration Template
# Duplicate this file as .env and adjust variables to match your local setup.
# DO NOT COMMIT REAL PRODUCTION PASSWORDS TO SOURCE CONTROL.
# ==============================================================================

# Backend Database Credentials
DB_URL=jdbc:mysql://localhost:3306/acxiom_crm?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Backend Server Configuration
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080/api
