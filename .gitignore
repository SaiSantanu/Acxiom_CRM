# ==============================================================================
# AcxiomCRM Root .gitignore
# ==============================================================================

# Environment & Secrets (NEVER COMMIT SENSITIVE DATA)
.env
.env.*
!.env.example
*.local
*.pem
*.key
*.cert
application-local.properties
application-secret.properties

# Backend / Java / Maven
backend/target/
target/
*.class
*.jar
*.war
*.ear
*.nar
.mvn/wrapper/maven-wrapper.jar

# Frontend / Node.js
frontend/node_modules/
node_modules/
frontend/dist/
dist/
dist-ssr/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# IDE & Editor files
.idea/
*.iml
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.project
.classpath
.settings/

# OS specific files
.DS_Store
Thumbs.db
Desktop.ini

# Scratch files
scratch/
.gemini/
